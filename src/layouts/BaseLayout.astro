---
interface Props {
  title?: string;
  description?: string;
}

const siteName = 'Almanaque Alternativo';
const siteUrl = 'https://almanaquealternativo.com.br';
const defaultDescription =
  'Comunidade de estudos místicos e esotéricos sobre arquétipos, símbolos, velas, incensos, cristais e práticas para o homem comum.';

const {
  title = siteName,
  description = defaultDescription,
} = Astro.props;

const pageTitle = title === siteName ? `${siteName} | Estudos místicos e esotéricos` : `${title} | ${siteName}`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL('/logo.png', siteUrl).toString();

const navItems = [
  { href: '/', label: 'Início' },
  { href: '/dinheiro-e-prosperidade/', label: 'Dinheiro e prosperidade' },
  { href: '/trabalho/', label: 'Trabalho' },
  { href: '/relacionamentos/', label: 'Relacionamentos' },
  { href: '/biblioteca/', label: 'Biblioteca' },
  { href: '/loja/', label: 'Loja' },
  { href: '/login/', label: 'Entrar' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Almanaque Alternativo">
          <img class="brand-logo" src="/logo.png" alt="" />
          <span>
            <strong>Almanaque Alternativo</strong>
            <small>símbolos, arquétipos e estudos</small>
          </span>
        </a>

        <nav class="site-nav" aria-label="Navegacao principal">
          {
            navItems.map((item) => (
              <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <p>
          Almanaque Alternativo, uma comunidade de compartilhamento de estudos místicos e esotéricos
          para o esclarecimento do homem comum.
        </p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0d0b10;
    --bg-soft: #17121f;
    --panel: rgba(255, 255, 255, 0.07);
    --panel-strong: rgba(255, 255, 255, 0.11);
    --text: #f8f1e7;
    --muted: #b7a99a;
    --gold: #d64f4f;
    --violet: #9a7bff;
    --border: rgba(255, 255, 255, 0.13);
    --shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at top left, rgba(154, 123, 255, 0.26), transparent 32rem),
      radial-gradient(circle at 85% 10%, rgba(214, 168, 79, 0.18), transparent 28rem),
      var(--bg);
    color: var(--text);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  p {
    color: var(--muted);
    line-height: 1.75;
  }

  .site-shell {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
  }

  .brand,
  .site-nav,
  .site-footer,
  .card,
  .content-card,
  .newsletter-box,
  .article-shell {
    border: 1px solid var(--border);
    background: var(--panel);
    backdrop-filter: blur(18px);
    box-shadow: var(--shadow);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border-radius: 999px;
    padding: 10px 16px 10px 10px;
    overflow: hidden;
  }

  .brand small {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .brand-logo {
    display: block;
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #f8f1e7;
    object-fit: contain;
    padding: 5px;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border-radius: 999px;
    padding: 8px;
  }

  .site-nav a {
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.92rem;
    padding: 10px 14px;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    background: var(--panel-strong);
    color: var(--text);
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--gold);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section {
    padding: 56px 0;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 22px;
  }

  .section-heading h2,
  .page-title h1,
  .hero h1 {
    margin: 0;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: stretch;
    padding: 56px 0 28px;
  }

  .hero h1 {
    max-width: 1040px;
    font-size: clamp(3rem, 7vw, 6.2rem);
  }

  .hero-lead {
    max-width: 960px;
    font-size: 1.2rem;
  }

  .hero-panel {
    border-radius: 32px;
    padding: 32px;
    background:
      linear-gradient(145deg, rgba(214, 168, 79, 0.22), rgba(154, 123, 255, 0.12)),
      var(--panel);
    border: 1px solid var(--border);
  }

  .hero-panel strong {
    display: block;
    margin-bottom: 8px;
    color: var(--text);
    font-size: 1.35rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--panel-strong);
    color: var(--text);
    font-weight: 700;
    padding: 13px 18px;
  }

  .button.primary {
    background: var(--gold);
    color: #17110b;
  }

  .button:disabled {
    cursor: not-allowed;
    opacity: 0.65;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .category-list {
    display: grid;
    gap: 42px;
  }

  .category-heading {
    margin-bottom: 18px;
  }

  .category-heading h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .card,
  .content-card,
  .newsletter-box,
  .article-shell {
    border-radius: 28px;
  }

  .card,
  .content-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    padding: 24px;
  }

  .card span,
  .content-card time {
    color: var(--gold);
    font-size: 0.83rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .card h3,
  .content-card h2,
  .content-card h3 {
    margin: 14px 0 8px;
  }

  .content-card p {
    margin-bottom: 24px;
  }

  .content-card .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }

  .content-card.product-card {
    padding: 0;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .product-card {
    overflow: visible;
  }

  .product-card-media {
    flex-shrink: 0;
    width: 100%;
    height: 360px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.2);
    border-bottom: 1px solid var(--border);
  }

  .product-card-perfume .product-card-media {
    height: 240px;
  }

  .product-card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .product-card-perfume .product-card-media img {
    object-fit: cover;
  }

  .product-card-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 24px;
  }

  .product-card-body {
    flex: 1;
  }

  .product-card-body h2 {
    margin: 10px 0 8px;
  }

  .product-card-body p {
    margin: 0;
  }

  .product-card-footer {
    display: flex;
    flex-direction: column;
    margin-top: 24px;
  }

  .product-card .tags {
    margin-top: 0;
    margin-bottom: 16px;
  }

  .product-specs {
    display: inline-flex;
    width: fit-content;
    margin-top: 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 6px 10px;
  }

  .product-price {
    margin: 0 0 12px;
    color: var(--text);
    font-size: 1.35rem;
    font-weight: 800;
  }

  .product-card .button {
    margin-top: 0;
  }

  .tag {
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.8rem;
    padding: 6px 10px;
  }

  .page-title {
    padding: 56px 0 24px;
  }

  .page-title h1 {
    max-width: 780px;
    font-size: clamp(2.6rem, 7vw, 5.4rem);
  }

  .page-title p {
    max-width: 720px;
    font-size: 1.12rem;
  }

  .newsletter-box {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
    gap: 24px;
    align-items: center;
    padding: 28px;
  }

  .newsletter-box form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-end;
  }

  .newsletter-box input {
    flex: 1 1 220px;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.18);
    color: var(--text);
    padding: 14px 16px;
  }

  .newsletter-box .button {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .auth-card,
  .comments-box {
    border: 1px solid var(--border);
    border-radius: 28px;
    background: var(--panel);
    box-shadow: var(--shadow);
    padding: 28px;
  }

  .comments-box {
    margin: -24px auto 64px;
    max-width: 820px;
  }

  .auth-form,
  .comment-form {
    display: grid;
    gap: 12px;
  }

  .auth-form label,
  .comment-form label {
    color: var(--text);
    font-weight: 700;
  }

  .auth-form input,
  .comment-form textarea {
    border: 1px solid var(--border);
    border-radius: 18px;
    background: rgba(0, 0, 0, 0.18);
    color: var(--text);
    font: inherit;
    padding: 14px 16px;
  }

  .comment-form textarea {
    min-height: 130px;
    resize: vertical;
  }

  .comments-list {
    display: grid;
    gap: 14px;
    margin-bottom: 24px;
  }

  .comment-card {
    border: 1px solid var(--border);
    border-radius: 20px;
    background: rgba(0, 0, 0, 0.16);
    padding: 16px;
  }

  .comment-card strong,
  .comment-card time {
    display: block;
  }

  .comment-card time {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .comment-card p {
    margin: 12px 0 0;
  }

  .auth-status,
  .comment-status {
    margin: 0;
    min-height: 1.5em;
  }

  .auth-status[data-state='success'],
  .comment-status[data-state='success'] {
    color: var(--text);
  }

  .auth-status[data-state='error'],
  .comment-status[data-state='error'] {
    color: var(--gold);
  }

  .article-shell {
    margin: 40px auto 64px;
    max-width: 820px;
    padding: 40px;
  }

  .article-shell h1 {
    margin: 8px 0 16px;
    font-size: clamp(2.4rem, 7vw, 4.4rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .article-body {
    margin-top: 28px;
  }

  .article-body h2 {
    margin-top: 36px;
  }

  .article-body img {
    display: block;
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: 24px;
    margin: 0 0 32px;
  }

  .article-body a {
    color: var(--gold);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin: 56px 0 24px;
    border-radius: 24px;
    padding: 20px 24px;
  }

  .site-footer p {
    flex: 1;
    margin: 0;
    font-size: 0.92rem;
  }

  @media (max-width: 860px) {
    .site-header,
    .hero,
    .newsletter-box,
    .site-footer {
      grid-template-columns: 1fr;
      flex-direction: column;
      align-items: stretch;
    }

    .site-nav {
      border-radius: 24px;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .newsletter-box form {
      flex-direction: column;
    }
  }
</style>
