---
import { getCollection } from 'astro:content';
import ProductCard from '../../components/ProductCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const publishedProducts = (await getCollection('produtos'))
  .filter((product) => !product.data.draft)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'pt-BR'));

const novidades = publishedProducts.filter((product) => product.data.featured);
const products = publishedProducts.filter((product) => !product.data.featured);
---

<BaseLayout
  title="Loja"
  description="Loja do Almanaque Alternativo com quadros de arquétipos, objetos de estudo, itens simbólicos e hipnose personalizada."
>
  <section class="page-title">
    <p class="eyebrow">Loja</p>
    <h1>Quadros, objetos simbólicos e hipnose para estudo e contemplação.</h1>
    <p>
      Uma primeira seleção de produtos do Almanaque Alternativo. Nesta fase, os pedidos podem ser
      feitos por WhatsApp ou link de pagamento externo.
    </p>
  </section>

  {
    novidades.length > 0 && (
      <section class="section shop-novidades" aria-labelledby="novidades">
        <div class="category-heading">
          <h2 id="novidades">Novidades</h2>
        </div>
        <div class="grid">
          {novidades.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      </section>
    )
  }

  <section class="section">
    {
      products.length > 0 ? (
        <div class="grid">
          {products.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      ) : (
        <p>Nenhum produto disponível no momento.</p>
      )
    }
  </section>
</BaseLayout>
